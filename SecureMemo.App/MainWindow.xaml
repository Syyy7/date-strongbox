<Window x:Class="SecureMemo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SecureMemo.App" Title="本地加密备忘录">
  <Grid x:Name="Root" Background="{ThemeResource WindowWash}" SizeChanged="LayoutChanged">
    <Grid.Resources>
      <ResourceDictionary Source="ms-appx:///GlassButtonColors.xaml"/>
    </Grid.Resources>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveShortcut"/>
      <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="LockShortcut"/>
    </Grid.KeyboardAccelerators>

    <Grid IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
      <Rectangle x:Name="Glow" Fill="{ThemeResource AmbientLight}"/>
      <Path Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Data="M 0,90 C 29,96 42,88 62,58 C 79,32 92,16 100,11 L 100,100 L 0,100 Z"
            Fill="{ThemeResource GlassContent}" Opacity=".32"/>
    </Grid>
    <Grid x:Name="MainContent">
    <Grid x:Name="Gate" Padding="20">
      <ScrollViewer x:Name="GateScroll" MaxWidth="448" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Border x:Name="GateCard" Style="{StaticResource GlassPanel}" Margin="2">
          <StackPanel Spacing="18">
            <StackPanel Spacing="8">
              <Border HorizontalAlignment="Center" Width="44" Height="44" CornerRadius="15" Background="{ThemeResource GlassField}" BorderBrush="{ThemeResource GlassRim}" BorderThickness="1">
                <FontIcon Glyph="&#xE72E;" FontSize="21"/>
              </Border>
              <TextBlock FontSize="{Binding Title, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="GateTitle" Text="解锁保险库" TextAlignment="Center" TextWrapping="Wrap" LineHeight="0" Style="{ThemeResource TitleTextBlockStyle}"/>
              <TextBlock FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="GateHint" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Spacing="12">
              <local:HoldPasswordField x:Name="Pass" Header="保险库密码"/>
              <local:HoldPasswordField x:Name="Confirm" Header="确认密码"/>
            </StackPanel>
            <Button Style="{StaticResource GlassPrimaryButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding ButtonInset, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="Enter" Content="解锁" HorizontalAlignment="Stretch" Click="EnterClick"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <Button Style="{StaticResource GlassButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding ButtonInset, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="GateSettings" AutomationProperties.Name="颜色设置" Click="OpenSettings"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE790;" FontSize="15"/><TextBlock FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" Text="颜色设置"/></StackPanel></Button>
            </StackPanel>
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="GateError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>

    <Grid x:Name="Workspace" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <Border Background="{ThemeResource GlassSurface}" Padding="24,14" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border x:Name="WorkspaceEmblem" Margin="0,0,8,0" CornerRadius="10" Background="#21574D"
                  Width="{Binding BadgeSide, Source={StaticResource Appearance}, Mode=OneWay}" Height="{Binding BadgeSide, Source={StaticResource Appearance}, Mode=OneWay}">
            <FontIcon Glyph="&#xE736;" Foreground="White" FontSize="{Binding IconSize, Source={StaticResource Appearance}, Mode=OneWay}"/>
          </Border>
          <TextBlock x:Name="WorkspaceHeading" Grid.Column="1" FontSize="{Binding Subtitle, Source={StaticResource Appearance}, Mode=OneWay}"
                     Text="我的保险库" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Style="{StaticResource GlassIconButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Width="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="WorkspaceSettings" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置" Click="OpenSettings"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
          <Button Style="{StaticResource GlassButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding ButtonInset, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" Click="LockClick" ToolTipService.ToolTip="锁定保险库 (Ctrl+L)"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72E;" FontSize="15"/><TextBlock FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" Text="锁定"/></StackPanel></Button>
        </StackPanel></Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="300"/><ColumnDefinition x:Name="DetailColumn" Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Rail" Background="{ThemeResource GlassSurface}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="{Binding CardInset, Source={StaticResource Appearance}, Mode=OneWay}">
          <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock TextTrimming="CharacterEllipsis" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="Count" Text="全部记录" VerticalAlignment="Center" FontWeight="SemiBold"/>
              <DropDownButton Style="{StaticResource GlassDropDownButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding ButtonInset, Source={StaticResource Appearance}, Mode=OneWay}" Grid.Column="1" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" Content="新建" HorizontalAlignment="Right"><DropDownButton.Flyout><MenuFlyout><MenuFlyoutItem FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" Text="新建笔记" Click="AddNote"/><MenuFlyoutItem FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" Text="新建账号" Click="AddAccount"/></MenuFlyout></DropDownButton.Flyout></DropDownButton>
            </Grid>
            <TextBox MinHeight="{Binding FieldHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding FieldInset, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" Grid.Row="1" x:Name="Search" PlaceholderText="搜索标题、账号或标签" AutomationProperties.Name="搜索记录" TextChanged="SearchChanged"/>
            <Grid Grid.Row="2"><ListView x:Name="Records" ContainerContentChanging="PrepareRecordMenu" SelectionChanged="SelectionChanged" IsItemClickEnabled="True" ItemClick="RecordClick">
              <ListView.ItemTemplate><DataTemplate x:DataType="local:RecordRow"><Grid Padding="{Binding RowInset, Source={StaticResource Appearance}, Mode=OneWay}" ColumnSpacing="{Binding Gap, Source={StaticResource Appearance}, Mode=OneWay}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <local:RecordBadge Appearance="{x:Bind Appearance, Mode=OneWay}"/>
                <StackPanel Grid.Column="1"><TextBlock FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" Text="{x:Bind Name,Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="{Binding Caption, Source={StaticResource Appearance}, Mode=OneWay}" Text="{x:Bind Kind}" LineHeight="0" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              </Grid></DataTemplate></ListView.ItemTemplate>
            </ListView><TextBlock FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="ListEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Text="暂无记录" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
          </Grid>
        </Border>
        <Grid x:Name="Detail" Grid.Column="1" Padding="{Binding PanelInset, Source={StaticResource Appearance}, Mode=OneWay}">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Button Style="{StaticResource GlassQuietButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding ButtonInset, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="Back" Content="‹  全部记录" Visibility="Collapsed" Click="BackClick"/>
          <StackPanel Grid.Row="1" x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <FontIcon Glyph="&#xE70B;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock FontSize="{Binding Subtitle, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="EmptyText" Text="创建第一条记录" LineHeight="0" Style="{ThemeResource SubtitleTextBlockStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><Button Style="{StaticResource GlassButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding ButtonInset, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" Content="新建笔记" Click="AddNote"/><Button Style="{StaticResource GlassButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding ButtonInset, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" Content="新建账号" Click="AddAccount"/></StackPanel>
          </StackPanel>
          <ScrollViewer Grid.Row="1" x:Name="Editor" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" Spacing="{Binding Gap, Source={StaticResource Appearance}, Mode=OneWay}" Padding="0,8,6,12">
              <Grid><StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Style="{StaticResource GlassButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="EditIcon" Click="EditIconClick" Padding="0" CornerRadius="10" AutomationProperties.Name="编辑记录图标" ToolTipService.ToolTip="更换图标和颜色"><local:RecordBadge x:Name="EditorBadge"/></Button>
                  <TextBlock FontSize="{Binding Subtitle, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="EditorKind" Text="笔记" VerticalAlignment="Center" LineHeight="0" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                </StackPanel>
                <Button Style="{StaticResource GlassIconButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Width="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" HorizontalAlignment="Right" AutomationProperties.Name="删除记录" ToolTipService.ToolTip="删除记录" Click="DeleteClick"><FontIcon Glyph="&#xE74D;" FontSize="17" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/></Button>
              </Grid>
              <Border Style="{StaticResource FieldGroup}" Padding="{Binding CardInset, Source={StaticResource Appearance}, Mode=OneWay}"><StackPanel Spacing="12"><TextBox MinHeight="{Binding FieldHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding FieldInset, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="RecordTitle" Header="标题" PlaceholderText="输入记录标题" TextChanged="FieldChanged"/><TextBox MinHeight="{Binding FieldHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding FieldInset, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="Tags" Header="标签" TextChanged="FieldChanged"/></StackPanel></Border>
              <Border x:Name="AccountCard" Style="{StaticResource FieldGroup}" Padding="{Binding CardInset, Source={StaticResource Appearance}, Mode=OneWay}"><StackPanel Spacing="12">
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox MinHeight="{Binding FieldHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding FieldInset, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="Username" Header="账号 / 用户名" TextChanged="FieldChanged"/>
                  <Button Style="{StaticResource GlassIconButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Width="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="CopyUsername" Grid.Column="1" VerticalAlignment="Bottom" Click="CopyClick" AutomationProperties.Name="复制账号" ToolTipService.ToolTip="复制账号"><FontIcon Glyph="&#xE8C8;" FontSize="16"/></Button>
                </Grid>
                <TextBox MinHeight="{Binding FieldHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding FieldInset, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="Site" Header="网站" TextChanged="FieldChanged"/>
                <Grid ColumnSpacing="8" RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <local:HoldPasswordField x:Name="Secret" Header="密码"/>
                  <StackPanel x:Name="PasswordActions" Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                  <Button Style="{StaticResource GlassIconButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Width="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" VerticalAlignment="Bottom" Click="CopyClick" AutomationProperties.Name="复制密码" ToolTipService.ToolTip="复制密码"><FontIcon Glyph="&#xE8C8;" FontSize="16"/></Button></StackPanel>
                </Grid>
              </StackPanel></Border>
              <Border Style="{StaticResource FieldGroup}" Padding="{Binding CardInset, Source={StaticResource Appearance}, Mode=OneWay}"><TextBox FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="Body" Header="正文" AcceptsReturn="True" MinHeight="140" TextWrapping="Wrap" TextChanged="FieldChanged"/></Border>
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="2" ColumnSpacing="8" Padding="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontSize="{Binding Caption, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="Status" VerticalAlignment="Center" MaxLines="2" TextWrapping="Wrap" LineHeight="0" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="SaveButton" Grid.Column="1" Style="{StaticResource GlassPrimaryButton}"
                    MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding ButtonInset, Source={StaticResource Appearance}, Mode=OneWay}"
                    FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" HorizontalAlignment="Right" AutomationProperties.Name="保存" Click="SaveClick">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon Glyph="&#xE74E;" FontSize="15"/><TextBlock Text="保存" VerticalAlignment="Center"/>
              </StackPanel>
            </Button></Grid>
        </Grid>
      </Grid>
    </Grid>
    </Grid>
    <local:SettingsPage x:Name="Settings" Visibility="Collapsed"/>
  </Grid>
</Window>
