<UserControl x:Class="SecureMemo.App.HoldPasswordField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <PasswordBox x:Name="Input" PasswordRevealMode="Hidden"
                     MinHeight="{Binding FieldHeight, Source={StaticResource Appearance}, Mode=OneWay}"
                     Padding="{Binding FieldInset, Source={StaticResource Appearance}, Mode=OneWay}"
                     FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}"/>
        <Button x:Name="Eye" Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource GlassIconButton}"
                Width="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}"
                Height="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}"
                ToolTipService.ToolTip="按住查看，松开隐藏（空格键）">
            <FontIcon Glyph="&#xE890;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
        </Button>
    </Grid>
</UserControl>
