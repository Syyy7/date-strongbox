<Page x:Class="SecureMemo.App.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:SecureMemo.App" Background="Transparent" SizeChanged="PageResized">
    <Page.Resources><local:AppearanceMetrics x:Key="Draft"/></Page.Resources>
    <Grid Padding="14">
        <ScrollViewer x:Name="SettingsScroll" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border x:Name="SettingsCard" Style="{StaticResource GlassPanel}" Padding="{Binding PanelInset, Source={StaticResource Appearance}, Mode=OneWay}" Margin="2">
                <StackPanel Spacing="20">
                    <Grid>
                        <Button Style="{StaticResource GlassIconButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Width="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="ReturnButton" Click="ReturnClick" VerticalAlignment="Center"
                                AutomationProperties.Name="返回" ToolTipService.ToolTip="返回"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button>
                        <TextBlock x:Name="PageTitle" Text="设置" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="{Binding Title, Source={StaticResource Appearance}, Mode=OneWay}"/>
                    </Grid>
                    <Grid x:Name="Sections" RowSpacing="0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="OtherColumn" Width="0"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel x:Name="VaultOptions" Spacing="14">
                            <TextBlock Text="自定义外观" FontWeight="SemiBold" FontSize="{Binding Subtitle, Source={StaticResource Appearance}, Mode=OneWay}"/>
                            <StackPanel Spacing="2">
                                <Grid><TextBlock Text="字号" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}"/><TextBlock x:Name="FontValue" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                                <Slider x:Name="FontSlider" AutomationProperties.Name="字号" Minimum="12" Maximum="20"
                                        StepFrequency="1" SmallChange="1" LargeChange="2" ValueChanged="PreviewChanged"/>
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <Grid><TextBlock Text="界面大小" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}"/><TextBlock x:Name="ScaleValue" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                                <Slider x:Name="ScaleSlider" AutomationProperties.Name="界面大小" Minimum="85" Maximum="130"
                                        StepFrequency="1" SmallChange="1" LargeChange="5" ValueChanged="PreviewChanged"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="实时预览" FontSize="{Binding Caption, Source={StaticResource Appearance}, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Border Style="{StaticResource FieldGroup}" Padding="12,8">
                                  <StackPanel Spacing="4">
                                    <Grid VerticalAlignment="Center" Padding="{Binding RowInset, Source={StaticResource Draft}, Mode=OneWay}" ColumnSpacing="{Binding Gap, Source={StaticResource Draft}, Mode=OneWay}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border x:Name="PreviewBadge" Width="{Binding BadgeSide, Source={StaticResource Draft}, Mode=OneWay}" Height="{Binding BadgeSide, Source={StaticResource Draft}, Mode=OneWay}"
                                                CornerRadius="10" Background="{ThemeResource GlassField}" BorderBrush="{ThemeResource GlassRim}" BorderThickness="1">
                                            <FontIcon Glyph="&#xE70B;" FontSize="{Binding IconSize, Source={StaticResource Draft}, Mode=OneWay}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="PreviewTitle" Text="旅行清单" FontWeight="SemiBold" FontSize="{Binding Body, Source={StaticResource Draft}, Mode=OneWay}" TextWrapping="Wrap"/>
                                            <TextBlock Text="笔记" FontSize="{Binding Caption, Source={StaticResource Draft}, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox x:Name="PreviewField" Text="出发前核对车票和证件" AutomationProperties.Name="示例笔记正文"
                                             IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap"
                                             FontSize="{Binding Body, Source={StaticResource Draft}, Mode=OneWay}"
                                             MinHeight="{Binding FieldHeight, Source={StaticResource Draft}, Mode=OneWay}"
                                             Padding="{Binding FieldInset, Source={StaticResource Draft}, Mode=OneWay}"/>
                                  </StackPanel>
                                </Border>
                            </StackPanel>
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource GlassButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding ButtonInset, Source={StaticResource Appearance}, Mode=OneWay}" x:Name="DefaultSizes" HorizontalAlignment="Stretch" Content="恢复默认" Click="ResetSizes" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}"/>
                                <Button x:Name="ApplySizes" Grid.Column="1" Style="{StaticResource GlassPrimaryButton}"
                                        MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding ButtonInset, Source={StaticResource Appearance}, Mode=OneWay}"
                                        FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="应用" Click="ApplyClick">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14"/><TextBlock Text="应用" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="OtherSettings" Spacing="18">
                            <RadioButtons x:Name="ThemeOptions" Header="颜色模式" MaxColumns="1" SelectionChanged="ThemeSelected" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}">
                                <RadioButton Content="跟随系统" Tag="Default" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}"/>
                                <RadioButton Content="浅色" Tag="Light" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}"/>
                                <RadioButton Content="深色" Tag="Dark" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}"/>
                            </RadioButtons>
                            <StackPanel x:Name="VaultActions" Spacing="10">
                                <TextBlock Text="备份" FontWeight="SemiBold" FontSize="{Binding Subtitle, Source={StaticResource Appearance}, Mode=OneWay}"/>
                                <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource GlassButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding ButtonInset, Source={StaticResource Appearance}, Mode=OneWay}" Content="导出备份" HorizontalAlignment="Stretch" Click="ExportClick" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}"/>
                                    <Button Style="{StaticResource GlassButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding ButtonInset, Source={StaticResource Appearance}, Mode=OneWay}" Content="导入备份" Grid.Column="1" HorizontalAlignment="Stretch" Click="ImportClick" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}"/>
                                </Grid>
                                <TextBlock Text="保险库密码" Margin="0,8,0,0" FontWeight="SemiBold" FontSize="{Binding Subtitle, Source={StaticResource Appearance}, Mode=OneWay}"/>
                                <Button Style="{StaticResource GlassButton}" MinHeight="{Binding ButtonHeight, Source={StaticResource Appearance}, Mode=OneWay}" Padding="{Binding ButtonInset, Source={StaticResource Appearance}, Mode=OneWay}" Content="修改密码" Click="ChangePasswordClick" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="Feedback" Visibility="Collapsed" TextWrapping="Wrap" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="SettingsError" Visibility="Collapsed" TextWrapping="Wrap" FontSize="{Binding Body, Source={StaticResource Appearance}, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
