<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="openssl-native" Version="3.5.9" GeneratePathProperty="true" ExcludeAssets="all" />
    <Content Include="$(Pkgopenssl-native)\runtimes\win-x64\native\libcrypto-3-x64.dll" Link="libcrypto-3-x64.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="SecureMemo.App" />
    <InternalsVisibleTo Include="WinFormsApp1" />
    <InternalsVisibleTo Include="SecureMemo.Checks" />
  </ItemGroup>
</Project>
